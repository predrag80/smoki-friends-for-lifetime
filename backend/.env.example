NODE_ENV=development
# api | worker | all
PROCESS_ROLE=api
HOST=0.0.0.0
PORT=4100
WORKER_HEALTH_PORT=4101

APP_URL=http://app.smoki.local
API_URL=http://api.smoki.local
CORS_ORIGINS=http://app.smoki.local,http://localhost:3100

# Services from dev/docker-compose.dev.yml
DATABASE_URL=postgresql://sffl:sffl@localhost:5433/sffl
VALKEY_URL=redis://localhost:6380

# Session cookie (shared between app. and api. subdomains)
SESSION_COOKIE_NAME=sffl_session
SESSION_COOKIE_DOMAIN=.smoki.local
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
SESSION_TTL_DAYS=7

# Private object storage (RustFS locally, S3-compatible in production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=sffl-private
STORAGE_ACCESS_KEY_ID=SFFLDEVACCESSKEY
STORAGE_SECRET_ACCESS_KEY=sffl-dev-secret-key
STORAGE_FORCE_PATH_STYLE=true

# Email: Mailpit from dev/docker-compose.dev.yml (inbox: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smoki Friend for a Lifetime <no-reply@smoki.local>"

# Google sign-in (optional locally). Create an OAuth "Web application" client in Google Cloud and add
# the redirect URI http://localhost:4100/auth/google/callback (Google allows http only on localhost).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_PUBLIC_BASE_URL=http://localhost:4100

# Versions of the client-owned legal texts
LEGAL_TERMS_VERSION=draft-2026-10
LEGAL_PRIVACY_VERSION=draft-2026-10
LEGAL_PHOTO_PROCESSING_VERSION=draft-2026-10
LEGAL_MARKETING_VERSION=draft-2026-10

# AI providers (added in generation phase)
GEMINI_API_KEY=
